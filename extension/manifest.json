{
  "manifest_version": 3,
  "name": "Radar de Oferta Real - Capturador",
  "version": "0.4.0",
  "description": "Captura o preço final real no checkout e pode monitorar automaticamente abas abertas do Mercado Livre.",
  "permissions": ["activeTab", "storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.mercadolivre.com.br/*",
    "https://llgaeuvtrcpcvrcxkvpz.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Radar de Oferta Real",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.mercadolivre.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}